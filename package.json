{
  "name": "payment-webhook-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Reference implementation of a reliable payment-webhook pipeline. Fictional data only.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts --passWithNoTests",
    "check": "npm run typecheck && npm run lint && npm run test",
    "secrets": "node scripts/gen-secrets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
